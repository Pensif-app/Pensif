{
  "expo": {
    "name": "Pensif",
    "slug": "pensif-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yomic.pensif",
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yomic.pensif",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1A1437",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Pensif peut utiliser tes contacts pour créer une fiche plus vite, uniquement si tu choisis d'importer quelqu'un."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7257E8"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1A1437",
          "dark": {
            "backgroundColor": "#111124"
          }
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Pensif a besoin du micro pour enregistrer une pensée dictée à voix haute.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "187aaa37-eded-40c5-a12e-1c0053579bbc"
      }
    },
    "owner": "yomic"
  }
}
