# CHANTIER CAPTURE INTELLIGENTE — noms des variables attendues par l'Edge Function `capture`.
# Aucune vraie valeur ici. À configurer en production via `supabase secrets set NOM=valeur`,
# jamais dans l'app mobile ni committé dans ce dépôt.

# Sélection des fournisseurs — "mock" ne nécessite aucune clé (aucun appel réseau réel).
# STT_PROVIDER : mock | openai | groq
STT_PROVIDER=mock
STT_MODEL=
LLM_PROVIDER=mock
LLM_MODEL=

# Requis uniquement si STT_PROVIDER=openai
OPENAI_API_KEY=

# Requis uniquement si STT_PROVIDER=groq
GROQ_API_KEY=

# Requis uniquement si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sont injectées AUTOMATIQUEMENT par
# Supabase pour toute Edge Function déployée — ne pas les redéfinir manuellement.
